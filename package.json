{
  "name": "gpt-realtime-whisper-live-transcript-redactor",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @gpt-realtime-whisper-live-transcript-redactor/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @gpt-realtime-whisper-live-transcript-redactor/web build",
    "typecheck": "pnpm --filter @gpt-realtime-whisper-live-transcript-redactor/web typecheck",
    "lint": "pnpm --filter @gpt-realtime-whisper-live-transcript-redactor/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @gpt-realtime-whisper-live-transcript-redactor/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "ajv@^6.0.0": "^6.14.0",
      "ajv@^8.0.0": "^8.18.0",
      "minimatch@^3.0.0": "^3.1.4",
      "minimatch@^9.0.0": "^9.0.7",
      "minimatch@^10.0.0": "^10.2.3",
      "picomatch@^2.0.0": "^2.3.2",
      "picomatch@^4.0.0": "^4.0.4",
      "brace-expansion@^1.0.0": "^1.1.17",
      "brace-expansion@^2.0.0": "^2.1.3",
      "path-to-regexp": "^8.4.0",
      "flatted": "^3.4.2",
      "postcss": "^8.5.23",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "nanoid": "^3.3.18",
      "shell-quote": "^1.9.0",
      "js-yaml": "^4.3.1",
      "body-parser": "^2.3.0",
      "qs": "^6.15.2",
      "express-rate-limit": "^8.2.2",
      "@babel/core": "^7.29.6",
      "sharp": "^0.35.0",
      "lodash": "^4.18.0"
    }
  }
}
